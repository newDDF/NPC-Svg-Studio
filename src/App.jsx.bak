import React, { useState, useMemo, useEffect } from 'react';
import { 
  Wand2, 
  Upload, 
  Copy, 
  Code2, 
  FileType2, 
  Download, 
  Eye, 
  Plus, 
  Minus, 
  Sliders, 
  Palette,
  Sun,
  Moon,
  Monitor,
  RotateCw,
  FlipHorizontal,
  FlipVertical,
  Image as ImageIcon,
  RotateCcw
} from 'lucide-react';
import { 
  extractColors, 
  replaceColor, 
  optimizeSvgWithOptions, 
  convertToReactComponent, 
  convertToVueComponent,
  convertToSvelteComponent,
  convertToCssDataUri 
} from './utils/svgProcessor';

// 你的专属 NPC-Svg-Studio 品牌 Logo
function CustomBrandLogo() {
  return (
    <svg className="w-8 h-8 rounded-xl shadow-md transition-transform hover:scale-105" viewBox="0 0 120 120">
      <rect fill="#6366f1" x="-.26" y="-.73" width="120" height="120" rx="30.16" ry="30.16"/>
      <g fill="#ffffff">
        <polygon points="49.26 75.82 34.04 84.6 34.04 74.38 20.83 92.11 34.49 100 51.33 90.28 62.29 36.46 49.26 53.95 49.26 75.82"/>
        <polygon points="89.16 78.03 89.16 85.41 77.67 78.81 77.67 62.68 67.96 49.72 67.96 84.38 98.26 90.18 95.21 86.11 89.16 78.03"/>
        <polygon points="89.16 47.55 89.16 76.53 95.99 85.66 98.5 89.01 88.39 36.74 68.17 48.51 77.67 61.18 77.67 54.24 89.16 47.55"/>
        <polygon points="98.04 91.05 70.05 85.69 88.71 96.41 98.04 91.05"/>
        <polygon points="98.86 86.17 98.86 42.39 96.37 40.96 89.34 36.91 98.86 86.17"/>
        <polygon points="20.61 87.56 33.86 18.71 20.61 26.36 20.61 87.56"/>
        <polygon points="34.04 72.88 34.04 33.74 49.26 42.64 49.26 52.46 55.17 44.52 62.47 34.72 34.81 18.54 20.97 90.42 34.04 72.88"/>
        <polygon points="62.68 39.03 52.38 89.62 62.68 83.64 62.68 39.03"/>
      </g>
    </svg>
  );
}

// 预制图形：只提供你的专属图标
const PRESETS = {
  myLogo: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120"><rect fill="#6366f1" x="-.26" y="-.73" width="120" height="120" rx="30.16" ry="30.16"/><g fill="#ffffff"><polygon points="49.26 75.82 34.04 84.6 34.04 74.38 20.83 92.11 34.49 100 51.33 90.28 62.29 36.46 49.26 53.95 49.26 75.82"/><polygon points="89.16 78.03 89.16 85.41 77.67 78.81 77.67 62.68 67.96 49.72 67.96 84.38 98.26 90.18 95.21 86.11 89.16 78.03"/><polygon points="89.16 47.55 89.16 76.53 95.99 85.66 98.5 89.01 88.39 36.74 68.17 48.51 77.67 61.18 77.67 54.24 89.16 47.55"/><polygon points="98.04 91.05 70.05 85.69 88.71 96.41 98.04 91.05"/><polygon points="98.86 86.17 98.86 42.39 96.37 40.96 89.34 36.91 98.86 86.17"/><polygon points="20.61 87.56 33.86 18.71 20.61 26.36 20.61 87.56"/><polygon points="34.04 72.88 34.04 33.74 49.26 42.64 49.26 52.46 55.17 44.52 62.47 34.72 34.81 18.54 20.97 90.42 34.04 72.88"/><polygon points="62.68 39.03 52.38 89.62 62.68 83.64 62.68 39.03"/></g></svg>`
};

// 12 种预制色系 + 黑 + 白
const EXTENDED_PALETTES = [
  { name: 'Indigo', color: '#6366f1' },
  { name: 'Violet', color: '#8b5cf6' },
  { name: 'Purple', color: '#a855f7' },
  { name: 'Blue', color: '#3b82f6' },
  { name: 'Cyan', color: '#06b6d4' },
  { name: 'Emerald', color: '#10b981' },
  { name: 'Green', color: '#22c55e' },
  { name: 'Amber', color: '#f59e0b' },
  { name: 'Orange', color: '#f97316' },
  { name: 'Rose', color: '#f43f5e' },
  { name: 'Pink', color: '#ec4899' },
  { name: 'Slate', color: '#64748b' },
  { name: 'Black', color: '#000000' },
  { name: 'White', color: '#ffffff' }
];

export default function App() {
  const [svgCode, setSvgCode] = useState(PRESETS.myLogo);
  const [originalSvgBackup, setOriginalSvgBackup] = useState(PRESETS.myLogo); // 用于一键还原
  const [activeTab, setActiveTab] = useState('styles');
  const [viewMode, setViewMode] = useState('canvas');
  const [zoom, setZoom] = useState(100);
  const [toast, setToast] = useState('');
  const [theme, setTheme] = useState('dark');

  // Geometry Controls
  const [rotation, setRotation] = useState(0);
  const [flipX, setFlipX] = useState(false);
  const [flipY, setFlipY] = useState(false);
  const [opacity, setOpacity] = useState(100);

  // Export Controls
  const [exportFormat, setExportFormat] = useState('react');
  const [componentName, setComponentName] = useState('IconSvg');
  const [rasterScale, setRasterScale] = useState(2);

  // SVGO Options
  const [cleanOptions, setCleanOptions] = useState({
    removeComments: true,
    removeMetadata: true,
    removeEditorData: true,
    removeEmptyAttrs: true,
    collapseWhitespace: true
  });

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', theme);
  }, [theme]);

  const colors = useMemo(() => extractColors(svgCode), [svgCode]);
  const originalSize = useMemo(() => new Blob([svgCode]).size, [svgCode]);

  const showToast = (msg) => {
    setToast(msg);
    setTimeout(() => setToast(''), 2200);
  };

  const handleColorChange = (targetColor, newColor) => {
    setSvgCode(replaceColor(svgCode, targetColor, newColor));
  };

  const applyPaletteColor = (newColor) => {
    if (colors.length > 0) {
      let updated = svgCode;
      colors.forEach(c => {
        updated = replaceColor(updated, c, newColor);
      });
      setSvgCode(updated);
      showToast(`Applied color: ${newColor}`);
    }
  };

  // 一键还原到初始载入状态
  const handleReset = () => {
    setSvgCode(originalSvgBackup);
    setRotation(0);
    setFlipX(false);
    setFlipY(false);
    setOpacity(100);
    showToast('✨ Restored to original state');
  };

  const handleOptimize = () => {
    const optimized = optimizeSvgWithOptions(svgCode, cleanOptions);
    const newSize = new Blob([optimized]).size;
    const savings = (((originalSize - newSize) / originalSize) * 100).toFixed(1);
    setSvgCode(optimized);
    showToast(`✨ Optimized! Savings: ${savings}% (${newSize} B)`);
  };

  const copyToClipboard = (text, label) => {
    navigator.clipboard.writeText(text);
    showToast(`Copied ${label}`);
  };

  const handleFileUpload = (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      if (typeof event.target?.result === 'string') {
        setSvgCode(event.target.result);
        setOriginalSvgBackup(event.target.result); // 更新备份用于还原
        showToast(`Loaded ${file.name}`);
      }
    };
    reader.readAsText(file);
  };

  const generatedCode = useMemo(() => {
    switch (exportFormat) {
      case 'react':
        return convertToReactComponent(svgCode, componentName);
      case 'vue':
        return convertToVueComponent(svgCode, componentName);
      case 'svelte':
        return convertToSvelteComponent(svgCode);
      case 'clean':
        return optimizeSvgWithOptions(svgCode, cleanOptions);
      case 'datauri':
        return convertToCssDataUri(svgCode);
      default:
        return svgCode;
    }
  }, [svgCode, exportFormat, componentName, cleanOptions]);

  const exportRaster = (format = 'png') => {
    const blob = new Blob([svgCode], { type: 'image/svg+xml;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const img = new Image();
    img.onload = () => {
      const canvas = document.createElement('canvas');
      const size = 512 * rasterScale;
      canvas.width = size;
      canvas.height = size;
      const ctx = canvas.getContext('2d');
      ctx.drawImage(img, 0, 0, size, size);
      
      const imgUrl = canvas.toDataURL(`image/${format}`);
      const link = document.createElement('a');
      link.href = imgUrl;
      link.download = `npc-svg-export-${rasterScale}x.${format}`;
      link.click();
      URL.revokeObjectURL(url);
      showToast(`Exported ${format.toUpperCase()} (${rasterScale}x)`);
    };
    img.src = url;
  };

  const isLight = theme === 'light';

  return (
    <div className={`h-screen w-screen flex flex-col font-sans select-none overflow-hidden transition-colors duration-200 ${
      isLight ? 'bg-slate-100 text-slate-900' : theme === 'oled' ? 'bg-black text-white' : 'bg-[#060911] text-slate-100'
    }`}>
      
      {/* Toast Notification */}
      {toast && (
        <div className="fixed top-20 right-8 z-50 bg-indigo-600 text-white px-4 py-2 rounded-xl shadow-2xl text-xs font-medium tracking-wide flex items-center space-x-2 animate-bounce">
          <span>{toast}</span>
        </div>
      )}

      {/* Header */}
      <header className={`h-16 px-6 flex items-center justify-between shrink-0 z-40 border-b backdrop-blur-md ${
        isLight ? 'bg-white/80 border-slate-200' : theme === 'oled' ? 'bg-[#050505] border-neutral-800' : 'bg-[#0b0e17]/90 border-slate-800/80'
      }`}>
        <div className="flex items-center space-x-3">
          <CustomBrandLogo />
          <div>
            <div className="flex items-center space-x-2">
              <h1 className="text-sm font-bold tracking-tight">NPC-Svg-Studio</h1>
              <span className={`text-[10px] font-mono px-2 py-0.5 rounded-full border ${
                isLight ? 'bg-indigo-50 text-indigo-600 border-indigo-200' : 'bg-indigo-500/10 text-indigo-400 border-indigo-500/20'
              }`}>
                Pro Edition
              </span>
            </div>
            <p className="text-[10px] opacity-60">Professional Vector Suite</p>
          </div>
        </div>

        {/* Presets (仅提供你的图标) & View Mode */}
        <div className="flex items-center space-x-6">
          <div className={`hidden md:flex items-center space-x-2 px-3 py-1.5 rounded-xl border ${
            isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900/80 border-slate-800'
          }`}>
            <span className="text-[11px] opacity-60 mr-1">Preset:</span>
            <button 
              onClick={() => { setSvgCode(PRESETS.myLogo); setOriginalSvgBackup(PRESETS.myLogo); showToast('Loaded NPC-Svg-Studio Logo'); }} 
              className="text-[11px] text-indigo-400 hover:underline font-medium px-1.5 flex items-center space-x-1"
            >
              <span>⭐ NPC Logo</span>
            </button>
          </div>

          <div className={`flex items-center space-x-1 p-1 rounded-xl border ${
            isLight ? 'bg-slate-100 border-slate-200' : 'bg-slate-800/40 border-slate-700/30'
          }`}>
            <button
              onClick={() => setViewMode('canvas')}
              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${
                viewMode === 'canvas' ? 'bg-indigo-600 text-white shadow' : isLight ? 'text-slate-600' : 'text-slate-400'
              }`}
            >
              <Eye className="w-3.5 h-3.5" />
              <span>Canvas</span>
            </button>
            <button
              onClick={() => setViewMode('code')}
              className={`flex items-center space-x-1.5 px-3 py-1.5 text-xs font-medium rounded-lg transition-all ${
                viewMode === 'code' ? 'bg-indigo-600 text-white shadow' : isLight ? 'text-slate-600' : 'text-slate-400'
              }`}
            >
              <Code2 className="w-3.5 h-3.5" />
              <span>Code Editor</span>
            </button>
          </div>
        </div>

        {/* Right Actions */}
        <div className="flex items-center space-x-3">
          <div className={`flex items-center p-1 rounded-xl border ${
            isLight ? 'bg-slate-100 border-slate-200' : 'bg-slate-800/40 border-slate-700/30'
          }`}>
            <button onClick={() => setTheme('dark')} className={`p-1.5 rounded-lg transition ${theme === 'dark' ? 'bg-indigo-600 text-white' : 'opacity-60'}`}><Moon className="w-3.5 h-3.5" /></button>
            <button onClick={() => setTheme('light')} className={`p-1.5 rounded-lg transition ${theme === 'light' ? 'bg-indigo-600 text-white' : 'opacity-60'}`}><Sun className="w-3.5 h-3.5" /></button>
            <button onClick={() => setTheme('oled')} className={`p-1.5 rounded-lg transition ${theme === 'oled' ? 'bg-indigo-600 text-white' : 'opacity-60'}`}><Monitor className="w-3.5 h-3.5" /></button>
          </div>

          <label className={`px-3.5 py-1.5 text-xs font-medium rounded-xl transition cursor-pointer flex items-center space-x-1.5 border ${
            isLight ? 'bg-white border-slate-200 hover:bg-slate-50 text-slate-700' : 'bg-slate-800/40 border-slate-700/30 hover:bg-slate-800 text-slate-200'
          }`}>
            <Upload className="w-3.5 h-3.5 opacity-70" />
            <span>Upload</span>
            <input type="file" accept=".svg" onChange={handleFileUpload} className="hidden" />
          </label>

          <button
            onClick={handleOptimize}
            className="px-4 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl transition shadow-md shadow-indigo-600/20 cursor-pointer flex items-center space-x-1.5"
          >
            <Wand2 className="w-3.5 h-3.5" />
            <span>Export SVG</span>
          </button>
        </div>
      </header>

      {/* Workspace */}
      <div className="flex-1 flex overflow-hidden p-6 gap-6 relative">
        
        {/* Left Viewport */}
        <div className={`flex-1 flex flex-col rounded-3xl border overflow-hidden relative shadow-xl backdrop-blur-xl ${
          isLight ? 'bg-white border-slate-200' : theme === 'oled' ? 'bg-[#050505] border-neutral-800' : 'bg-[#0a0f1d]/60 border-slate-800/80'
        }`}>
          <div className={`h-12 px-6 flex items-center justify-between border-b shrink-0 ${
            isLight ? 'border-slate-100 text-slate-500' : 'border-slate-800/60 text-slate-400'
          }`}>
            <div className="flex items-center space-x-3 text-xs font-mono">
              <span className="flex items-center space-x-1">
                <span className="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Active SVG</span>
              </span>
              <span>•</span>
              <span>Size: {(originalSize / 1024).toFixed(2)} KB</span>
            </div>

            {viewMode === 'canvas' && (
              <div className={`flex items-center space-x-1 px-2 py-1 rounded-lg border ${
                isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-800/40 border-slate-700/30'
              }`}>
                <button onClick={() => setZoom(z => Math.max(50, z - 25))} className="p-1 rounded opacity-70 hover:opacity-100"><Minus className="w-3 h-3" /></button>
                <span className="text-[11px] font-mono w-10 text-center">{zoom}%</span>
                <button onClick={() => setZoom(z => Math.min(200, z + 25))} className="p-1 rounded opacity-70 hover:opacity-100"><Plus className="w-3 h-3" /></button>
              </div>
            )}
          </div>

          <div className={`flex-1 flex items-center justify-center p-8 overflow-auto relative ${
            isLight ? 'bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] bg-[size:20px_20px]' : 'bg-[radial-gradient(#1e293b_1px,transparent_1px)] bg-[size:20px_20px]'
          }`}>
            {viewMode === 'canvas' ? (
              <div 
                className={`p-12 rounded-2xl border shadow-2xl transition-all flex items-center justify-center ${
                  isLight ? 'bg-white border-slate-200' : 'bg-[#070b14] border-slate-800/80'
                }`}
                style={{ 
                  transform: `scale(${zoom / 100}) rotate(${rotation}deg) scaleX(${flipX ? -1 : 1}) scaleY(${flipY ? -1 : 1})`,
                  opacity: opacity / 100,
                  minWidth: '300px', 
                  minHeight: '300px'
                }}
                dangerouslySetInnerHTML={{ __html: svgCode }}
              />
            ) : (
              <div className="w-full h-full relative p-4 flex flex-col">
                <textarea
                  value={svgCode}
                  onChange={(e) => setSvgCode(e.target.value)}
                  className={`w-full h-full font-mono text-xs p-5 rounded-2xl border leading-relaxed focus:outline-none resize-none shadow-inner ${
                    isLight 
                      ? 'bg-slate-50 border-slate-200 text-slate-900 font-semibold selection:bg-indigo-100' 
                      : 'bg-[#03050a] border-indigo-500/30 text-indigo-200 font-mono tracking-wide selection:bg-indigo-600/50'
                  }`}
                  spellCheck="false"
                />
              </div>
            )}
          </div>
        </div>

        {/* Right Sidebar Control Panel */}
        <div className={`w-96 flex flex-col rounded-3xl border shadow-xl overflow-hidden shrink-0 ${
          isLight ? 'bg-white border-slate-200' : theme === 'oled' ? 'bg-[#050505] border-neutral-800' : 'bg-[#0a0f1d]/80 border-slate-800/80'
        }`}>
          
          {/* Tabs */}
          <div className={`flex border-b p-2 gap-1 shrink-0 ${isLight ? 'border-slate-100 bg-slate-50/50' : 'border-slate-800/60 bg-slate-900/30'}`}>
            {[
              { id: 'styles', label: 'Styles', icon: Palette },
              { id: 'geometry', label: 'Geometry', icon: Sliders },
              { id: 'clean', label: 'Clean', icon: Wand2 },
              { id: 'export', label: 'Export', icon: Download }
            ].map((tab) => {
              const Icon = tab.icon;
              return (
                <button
                  key={tab.id}
                  onClick={() => setActiveTab(tab.id)}
                  className={`flex-1 py-2 text-xs font-medium rounded-xl transition flex items-center justify-center space-x-1.5 ${
                    activeTab === tab.id 
                      ? 'bg-indigo-600 text-white shadow-md' 
                      : isLight ? 'text-slate-600 hover:bg-slate-200/60' : 'text-slate-400 hover:text-slate-200 hover:bg-slate-800/40'
                  }`}
                >
                  <Icon className="w-3.5 h-3.5" />
                  <span>{tab.label}</span>
                </button>
              );
            })}
          </div>

          {/* Panel Body */}
          <div className="flex-1 p-5 overflow-y-auto space-y-6">
            
            {/* 1. STYLES TAB (12 种色系 + 黑 + 白 + 一键还原) */}
            {activeTab === 'styles' && (
              <div className="space-y-6">
                <div>
                  <div className="flex items-center justify-between mb-3">
                    <h3 className={`text-xs font-semibold uppercase tracking-wider ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                      Extracted Colors ({colors.length})
                    </h3>
                  </div>

                  {colors.length === 0 ? (
                    <p className="text-xs text-slate-400 italic py-2">No adjustable color attributes detected.</p>
                  ) : (
                    <div className="space-y-2 max-h-[150px] overflow-y-auto pr-1">
                      {colors.map((color, index) => (
                        <div key={index} className={`flex items-center justify-between p-2 rounded-xl border ${
                          isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900/60 border-slate-800'
                        }`}>
                          <div className="flex items-center space-x-3">
                            <input
                              type="color"
                              value={color.startsWith('#') && (color.length === 4 || color.length === 7) ? color : '#6366f1'}
                              onChange={(e) => handleColorChange(color, e.target.value)}
                              className="w-6 h-6 rounded cursor-pointer bg-transparent border-0"
                            />
                            <span className="text-xs font-mono">{color}</span>
                          </div>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                {/* 12 色系 + 黑 + 白 + 一键还原 */}
                <div className="border-t pt-4 border-slate-800/40 space-y-3">
                  <div className="flex items-center justify-between">
                    <h3 className={`text-xs font-semibold uppercase tracking-wider ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                      Extended Theme Palettes
                    </h3>
                    <button
                      onClick={handleReset}
                      className="px-2.5 py-1 text-[11px] font-medium bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 rounded-lg border border-rose-500/20 transition flex items-center space-x-1 cursor-pointer"
                      title="Reset to original state"
                    >
                      <RotateCcw className="w-3 h-3" />
                      <span>Reset</span>
                    </button>
                  </div>

                  <div className="grid grid-cols-2 gap-2">
                    {EXTENDED_PALETTES.map((p, idx) => (
                      <button
                        key={idx}
                        onClick={() => applyPaletteColor(p.color)}
                        className={`flex items-center space-x-2 p-2 rounded-xl border text-xs font-medium transition cursor-pointer ${
                          isLight ? 'bg-slate-50 hover:bg-slate-100 border-slate-200' : 'bg-slate-900/60 hover:bg-slate-800/80 border-slate-800'
                        }`}
                      >
                        <span className="w-3.5 h-3.5 rounded-full shadow-sm border border-black/10" style={{ backgroundColor: p.color }}></span>
                        <span className="truncate">{p.name}</span>
                      </button>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {/* 2. GEOMETRY TAB */}
            {activeTab === 'geometry' && (
              <div className="space-y-5">
                <div>
                  <h3 className={`text-xs font-semibold uppercase tracking-wider mb-3 ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                    Transformations
                  </h3>
                  <div className="grid grid-cols-3 gap-2">
                    <button onClick={() => setRotation(r => (r + 90) % 360)} className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] space-y-1 ${isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'}`}>
                      <RotateCw className="w-3.5 h-3.5 text-indigo-400" />
                      <span>Rotate 90°</span>
                    </button>
                    <button onClick={() => setFlipX(!flipX)} className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] space-y-1 ${flipX ? 'border-indigo-500 bg-indigo-500/10' : isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'}`}>
                      <FlipHorizontal className="w-3.5 h-3.5 text-indigo-400" />
                      <span>Flip X</span>
                    </button>
                    <button onClick={() => setFlipY(!flipY)} className={`p-2 rounded-xl border flex flex-col items-center justify-center text-[10px] space-y-1 ${flipY ? 'border-indigo-500 bg-indigo-500/10' : isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'}`}>
                      <FlipVertical className="w-3.5 h-3.5 text-indigo-400" />
                      <span>Flip Y</span>
                    </button>
                  </div>
                </div>

                <div className="space-y-2 border-t pt-4 border-slate-800/40">
                  <div className="flex justify-between text-xs">
                    <span className="opacity-70">Global Opacity</span>
                    <span className="font-mono">{opacity}%</span>
                  </div>
                  <input type="range" min="10" max="100" value={opacity} onChange={e => setOpacity(Number(e.target.value))} className="w-full accent-indigo-600 cursor-pointer" />
                </div>
              </div>
            )}

            {/* 3. CLEAN TAB */}
            {activeTab === 'clean' && (
              <div className="space-y-4">
                <h3 className={`text-xs font-semibold uppercase tracking-wider ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                  SVGO Optimization Rules
                </h3>
                <div className="space-y-2">
                  {[
                    { key: 'removeComments', label: 'XML Comments' },
                    { key: 'removeMetadata', label: 'Metadata & Doctype' },
                    { key: 'removeEditorData', label: 'Figma / Sketch Markup' },
                    { key: 'removeEmptyAttrs', label: 'Empty Attributes' },
                    { key: 'collapseWhitespace', label: 'Minify Code' }
                  ].map(({ key, label }) => (
                    <label key={key} className={`flex items-center justify-between p-3 rounded-xl border cursor-pointer ${
                      isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900/60 border-slate-800'
                    }`}>
                      <span className="text-xs">{label}</span>
                      <input
                        type="checkbox"
                        checked={cleanOptions[key]}
                        onChange={(e) => setCleanOptions({ ...cleanOptions, [key]: e.target.checked })}
                        className="rounded accent-indigo-600 w-4 h-4 cursor-pointer"
                      />
                    </label>
                  ))}
                </div>

                <button
                  onClick={handleOptimize}
                  className="w-full py-3 bg-indigo-600 hover:bg-indigo-500 text-xs font-medium rounded-xl text-white transition flex items-center justify-center space-x-2 shadow-lg shadow-indigo-600/20 cursor-pointer"
                >
                  <Wand2 className="w-4 h-4" />
                  <span>Execute SVGO Optimization</span>
                </button>
              </div>
            )}

            {/* 4. EXPORT TAB */}
            {activeTab === 'export' && (
              <div className="space-y-5">
                <div>
                  <h3 className={`text-xs font-semibold uppercase tracking-wider mb-3 ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                    Target Code Format
                  </h3>
                  <div className="grid grid-cols-2 gap-2">
                    {[
                      { id: 'react', label: 'React Component' },
                      { id: 'vue', label: 'Vue 3 Component' },
                      { id: 'svelte', label: 'Svelte' },
                      { id: 'clean', label: 'Clean SVG' },
                      { id: 'datauri', label: 'Data URI' }
                    ].map(item => (
                      <button
                        key={item.id}
                        onClick={() => setExportFormat(item.id)}
                        className={`p-2 rounded-xl border text-xs font-medium transition cursor-pointer ${
                          exportFormat === item.id 
                            ? 'border-indigo-500 bg-indigo-600 text-white shadow-md' 
                            : isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'
                        }`}
                      >
                        {item.label}
                      </button>
                    ))}
                  </div>
                </div>

                {(exportFormat === 'react' || exportFormat === 'vue') && (
                  <div>
                    <label className="text-[10px] opacity-60 block mb-1">Component Name</label>
                    <input
                      type="text"
                      value={componentName}
                      onChange={e => setComponentName(e.target.value)}
                      className={`w-full px-3 py-1.5 rounded-xl border text-xs font-mono ${isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'}`}
                    />
                  </div>
                )}

                <div className="relative">
                  <textarea
                    readOnly
                    value={generatedCode}
                    className={`w-full h-28 font-mono text-[11px] p-3 rounded-xl border resize-none focus:outline-none ${
                      isLight ? 'bg-slate-50 border-slate-200 text-slate-800' : 'bg-[#03050a] border-slate-800 text-indigo-300'
                    }`}
                  />
                  <button
                    onClick={() => copyToClipboard(generatedCode, exportFormat.toUpperCase())}
                    className="absolute top-2 right-2 px-2 py-1 bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg text-[10px] font-medium shadow cursor-pointer"
                  >
                    Copy
                  </button>
                </div>

                {/* Raster Export */}
                <div className="border-t pt-4 border-slate-800/40 space-y-3">
                  <h3 className={`text-xs font-semibold uppercase tracking-wider ${isLight ? 'text-slate-600' : 'text-slate-400'}`}>
                    Raster Image Export (PNG / WebP)
                  </h3>
                  <div className="flex items-center space-x-2">
                    <span className="text-xs opacity-60">Scale:</span>
                    {[1, 2, 4, 8].map(s => (
                      <button
                        key={s}
                        onClick={() => setRasterScale(s)}
                        className={`px-2.5 py-1 text-xs rounded-lg font-mono border transition cursor-pointer ${
                          rasterScale === s ? 'bg-indigo-600 text-white border-indigo-500' : isLight ? 'bg-slate-50 border-slate-200' : 'bg-slate-900 border-slate-800'
                        }`}
                      >
                        {s}x
                      </button>
                    ))}
                  </div>

                  <div className="grid grid-cols-2 gap-2">
                    <button
                      onClick={() => exportRaster('png')}
                      className="py-2 bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-medium rounded-xl transition flex items-center justify-center space-x-1.5 shadow cursor-pointer"
                    >
                      <ImageIcon className="w-3.5 h-3.5" />
                      <span>Export PNG</span>
                    </button>
                    <button
                      onClick={() => exportRaster('webp')}
                      className="py-2 bg-slate-800 hover:bg-slate-700 text-white text-xs font-medium rounded-xl transition flex items-center justify-center space-x-1.5 shadow cursor-pointer"
                    >
                      <ImageIcon className="w-3.5 h-3.5" />
                      <span>Export WebP</span>
                    </button>
                  </div>
                </div>

              </div>
            )}

          </div>
        </div>

      </div>
    </div>
  );
}
